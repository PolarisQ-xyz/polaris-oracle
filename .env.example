# Never commit a real .env — see polaris-contracts/README.md for the
# corresponding on-chain pieces (feed ID placeholder, wasm hashes).

# --- required ---
ORACLE_SECRET_KEY=S...           # Stellar secret key; pays tx fees, no privileged role over user funds
ADMIN_API_KEY=                   # shared secret for admin endpoints — unset means every admin call is rejected

# --- market creation / deployment ---
# Market deployment (stellar contract deploy + invoke initialize) shells out
# to the Stellar CLI using DEPLOYER_SECRET_KEY as --source (falls back to
# ORACLE_SECRET_KEY if unset). Splitting this out is safe and cheap: a
# market's `admin` (set once at initialize()) is never checked again by any
# other entrypoint, so this key plays no ongoing role after deploy — see
# stellar.service.ts's deployerKeypair doc comment. If the always-hot
# ORACLE_SECRET_KEY is ever compromised, it can't deploy new markets
# claiming this system's trusted admin identity.
DEPLOYER_SECRET_KEY=              # optional; a separate funded testnet keypair, or leave unset to reuse ORACLE_SECRET_KEY
LAZER_CONTRACT=                  # deployed pyth-lazer-stellar verifier (or polaris-mock-lazer on testnet)
NATIVE_XLM_SAC=                  # native XLM Stellar Asset Contract id — the collateral every market uses
TREASURY_ADDRESS=                # protocol fee / AMM-seed-liquidity recipient; defaults to the oracle's own address
# Swap fee is now a per-market curve (base_fee_bps -> min_fee_bps as volume
# grows), set at market creation via POST /markets/create, not a global
# default here — see contracts/README.md's "Cost-driven fee curve".

# --- passkey smart wallets ---
# SMART_WALLET_FACTORY_CONTRACT must already have had `initialize(admin,
# wasm_hash)` called on it once (admin-authenticated) before deployWallet
# will do anything — see contracts/README.md's "Factory wasm pinning".
# SMART_WALLET_WASM_HASH isn't passed to the factory anymore (that was the
# bug); it's kept here only as the value you pin via `initialize`.
SMART_WALLET_FACTORY_CONTRACT=   # deployed + initialize()'d polaris-smart-wallet-factory contract id
SMART_WALLET_WASM_HASH=          # sha256 of polaris_smart_wallet.wasm — what initialize() pinned this factory to (hex)

# --- capital-efficiency vault / market factory ---
# See polaris-contracts/README.md's "The capital-efficiency vault" and
# MarketFactoryService for the full design. VAULT_CONTRACT must already be
# deployed, initialize()'d (admin = this same ORACLE_SECRET_KEY), and funded
# via deposit() — the factory only ever withdraws from it and reads its
# balance, never deposits or admin-configures it.
VAULT_CONTRACT=                  # deployed + initialize()'d polaris-vault contract id
# JSON array of {feedId, hermesFeedId, symbol}. feedId is the small-integer
# Pyth Lazer id (same scheme as XLM_USD_FEED_ID, used for settlement);
# hermesFeedId is Pyth's separate 32-byte-hex Hermes registry id (same
# distinction PriceController documents), read once per factory run to pick
# a fresh strike price. Unset falls back to a single XLM/USD entry using its
# real Hermes id (verified live against hermes.pyth.network — see
# configuration.ts) — fine as-is unless you're adding more feeds.
FEED_CATALOG=
MARKET_FACTORY_INTERVAL_SECS=300        # 5min — safety-net sweep; a 'finalized' event triggers a successor immediately, this just catches what a crash could miss
MARKET_FACTORY_EXPIRY_SECS=86400        # 24h — each auto-created market's lifetime
MARKET_FACTORY_GRACE_PERIOD_SECS=3600
MARKET_FACTORY_BASE_FEE_BPS=100
MARKET_FACTORY_MIN_FEE_BPS=20
MARKET_FACTORY_INITIAL_LIQUIDITY_STROOPS=1000000000   # 100 XLM, withdrawn from the vault per market created

# OddsSnapshotService — backs the frontend markets ticker's "Chg" column
# with real recorded history rather than a fabricated number.
ODDS_SNAPSHOT_INTERVAL_SECS=300          # 5min — how often each open market's odds are recorded
ODDS_CHANGE_WINDOW_SECS=3600             # 1h — the lookback window GET /markets/:id/price's yesBpsChange is computed against

# Settlement cross-check: before trusting the Lazer-signed settlement price,
# compare it against Hermes' independently-fetched current price for the
# same feed (only for feeds present in FEED_CATALOG above). Defense in depth
# on top of the on-chain signature verification, not a replacement for it —
# a gap beyond this tolerance falls back to cancel() instead of settling.
SETTLE_ORACLE_TOLERANCE_BPS=150   # 1.5% — deliberately loose, see configuration.ts

# On-chain second-oracle enforcement — Market.reflector, initialize()'s 12th
# param on every newly-deployed market (distinct from the off-chain check
# above: this one is enforced by the contract itself, not just the backend
# — see polaris-contracts/README.md's "On-chain second-oracle: Reflector
# Network"). REFLECTOR_CONTRACT has no safe default; markets/create and the
# factory both refuse to deploy without it configured.
REFLECTOR_CONTRACT=              # a deployed Reflector oracle instance, e.g. the real testnet one: CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63
REFLECTOR_ASSET=XLM
REFLECTOR_MAX_STALENESS_SECS=600 # must be >= the configured oracle's own resolution() — validated on-chain at initialize()
REFLECTOR_TOLERANCE_BPS=150

# contracts/perpetual's price_oracle bundle requires both the Reflector and
# RedStone legs together whenever it's configured at all (see
# polaris-contracts/README.md's "A third oracle: RedStone") — RedStone has
# no testnet deployment, so this points at polaris-mock-redstone (see that
# README) instead. Leave unset (along with LAZER_CONTRACT/REFLECTOR_CONTRACT
# above being all that's needed for classic markets) to keep every newly
# created perpetual's price_oracle as None, as before this existed.
MOCK_REDSTONE_CONTRACT=
REDSTONE_MAX_STALENESS_SECS=600
REDSTONE_TOLERANCE_BPS=150

# --- Pyth ---
PYTH_LAZER_TOKEN=                # without this, markets settle via settle_via_reflector (Reflector-only, no Lazer payload) instead of a Lazer-verified settle()
XLM_USD_FEED_ID=100              # PLACEHOLDER — look up the real Lazer feed id for XLM/USD before mainnet
PYTH_LAZER_WS_URL=wss://pyth-lazer.dourolabs.app/v1/stream
PYTH_HERMES_URL=https://hermes.pyth.network

# --- network ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_NETWORK=testnet
MARKET_WASM_HASH=                # optional pin; recorded in polaris-contracts/README.md after each build
PERPETUAL_WASM_HASH=              # optional pin; recorded in polaris-contracts/README.md after each build

# --- email custodial wallets ---
# EMAIL_WALLET_ENC_KEY and SESSION_JWT_SECRET must be set in production;
# the app generates a random dev fallback and logs a warning when they are
# absent, but that fallback is NOT safe to use — sessions from one process
# restart are invalidated, and any secrets encrypted under it are lost.
EMAIL_WALLET_ENC_KEY=            # 32-byte hex AES-256-GCM key for custodial wallet encryption (required in production)
SESSION_JWT_SECRET=              # secret for signing session JWTs (required in production)
SESSION_TTL_SECS=2592000         # 30 days
EMAIL_PROVIDER=console           # 'console' (dev, logs codes to stdout) or 'resend'
RESEND_API_KEY=                  # required when EMAIL_PROVIDER=resend
EMAIL_FROM=Polaris <login@polaris.app>
EMAIL_CODE_TTL_SECS=600          # 10 minutes
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECS=60
# emailWalletRpId and emailWalletOrigin are embedded in the custodial
# client_data_json that the smart-wallet contract verifies on-chain.
# They MUST match the frontend origin exactly — a mismatch causes every
# email-wallet trade to fail with OriginMismatch.  Leaving these at the
# defaults is safe for local dev (localhost only), not for production.
EMAIL_WALLET_RP_ID=localhost     # must match the frontend's hostname
EMAIL_WALLET_ORIGIN=http://localhost:3000  # must match the frontend's exact origin

# --- faucet / testnet helpers ---
FRIENDBOT_URL=https://friendbot.stellar.org  # Stellar testnet faucet; only used by POST /faucet
FAUCET_AMOUNT_STROOPS=5000000000             # 500 XLM per faucet request

# --- settle freshness ---
SETTLE_FRESHNESS_WINDOW_SECS=300  # reject settle() calls referencing a price older than this

# --- server ---
PORT=3001
CORS_ORIGINS=http://localhost:3000
MARKETS_DB_FILE=./data/markets.db
FAUCET_MAX_PER_HOUR=3
WALLET_DEPLOY_MAX_PER_HOUR=5     # per-IP; mitigates but doesn't close POST /wallets/deploy's unauthenticated-abuse gap
